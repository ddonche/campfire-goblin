/// lib/views/pwa.gbln
/// pwa/_browser_settings, _system_settings and _install_instructions: help
/// for enabling notifications, chosen by the visitor's browser and system.

import lib/html as html
import lib/platform as platform

act switch_img(alt)
    return html::img("external/switch.svg", "alt=\"" + alt + "\" ", 22)
xx

act apple_menu_steps(app, alt)
    sw | switch_img(alt)
    return """            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>{app}</em>.</li>
            <li>Click <em>{sw}</em> to <em>Allow notifications</em>.</li>
"""
xx

act windows_steps(app, alt)
    sw | switch_img(alt)
    return """            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>{sw}</em> <em>ON</em> for {app}.</li>
"""
xx

act browser_settings(p, root_url)
    if (p{"safari"} or p{"chrome"}) and p{"ios"} => return ""
    browser | html::h(html::capitalize(p{"browser"}))
    web | html::img("external/web.svg", "aria-hidden=\"true\" ", 20)
    disclosure | html::img("disclosure.svg", "aria-hidden=\"true\" class=\"disclosure\" ", 10)
    lock | html::img("lock.svg", "alt=\"the View site information button\" ", 20)
    root | html::h(root_url)
    body | ""
    if p{"firefox"} and p{"android"}
        body |= """        <ol>
          <li>Tap <em>{lock}</em> in the address bar.</li>
          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>
        </ol>
"""
    elif p{"edge"} and platform::desktop(p)
        steps | apple_menu_steps(browser, "the switch")
        if p{"windows"} => steps |= windows_steps(browser, "the switch")
        body |= """        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>{lock}</em> left of the address bar.</li>
          <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>
        </ol>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {browser}.</h2>
        <ol>
{steps}        </ol>
"""
    elif p{"firefox"} and platform::desktop(p)
        steps | apple_menu_steps(browser, "the switch")
        if p{"windows"} => steps |= windows_steps(browser, "the toggle button")
        body |= """        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>{browser}</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click <em>Privacy & Security</em> in the sidebar.</li>
          <li>Scroll down to <em>Permissions</em>.</li>
          <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>
          <li>Select <em>Allow</em> next to <em>{root}</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {browser}.</h2>
        <ol>
{steps}        </ol>
"""
    elif p{"chrome"} and platform::desktop(p)
        sliders | html::img("external/sliders.svg", "alt=\"View site information\" ", 20)
        steps | apple_menu_steps(browser, "the switch")
        if p{"windows"} => steps |= windows_steps(browser, "the switch")
        body |= """        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click the <em>{sliders}</em> icon in the address bar.</li>
          <li>Click <em>Site Settings</em>.</li>
          <li>Ensure notifications are <em>Allowed</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {browser}.</h2>
        <ol>
{steps}        </ol>
"""
    elif p{"chrome"} and p{"android"}
        dots | html::img("menu-dots-vertical.svg", "alt=\"More options\" ", 16)
        sw | switch_img("the switch")
        bell | html::img("notification-bell-alert.svg", "alt=\"the notification bell\" ", 16)
        body |= """        <ol>
          <li>Tap the <em>{dots}</em> menu button.</li>
          <li>Tap <em>Settings</em>.</li>
          <li>Tap <em>Notifications</em>.</li>
          <li>Tap <em>{sw}</em> to <em>Allow {browser} notifications</em>.</li>
          <li>Tap <em>{sw}</em> next to <em>Web apps</em>.</li>
          <li>Tap <em>{bell}</em> and select <em>Allow</em>.</li>
        </ol>
"""
    elif p{"safari"} and platform::desktop(p)
        body |= """        <ol>
          <li>Click <em>{browser}</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click the <em>Websites</em> tab.</li>
          <li>Click <em>Notifications</em> in the sidebar.</li>
          <li>Click <em>{root}</em> in the list.</li>
          <li>Select <em>Allow</em>.</li>
        </ol>
"""
    else
        body |= """        <p>Ensure notifications are enabled for <em>{root}</em> in your web browser settings.</p>
"""
    xx
    return """  <details class="notifications-help" data-notifications-target="details">
    <summary class="btn">
      {web}
      <strong>Check your {browser} settings</strong>
      {disclosure}
    </summary>

{body}  </details>
"""
xx

act system_settings(p)
    os | html::h(p{"os"})
    browser | html::h(html::capitalize(p{"browser"}))
    gear | html::img("external/gear.svg", "aria-hidden=\"true\" ", 20)
    disclosure | html::img("disclosure.svg", "aria-hidden=\"true\" class=\"disclosure\" ", 10)
    body | ""
    if p{"firefox"} and p{"android"}
        dots | html::img("menu-dots-vertical.svg", "alt=\"More options\" ", 16)
        sw | switch_img("the toggle button")
        body |= """      <ol>
        <li>Tap the <em>{dots}</em> menu button.</li>
        <li>Tap <em>Settings</em>.</li>
        <li>Tap <em>Notifications</em>.</li>
        <li>Tap <em>{sw}</em> to <em>Allow {browser} notifications</em>.</li>
      </ol>
"""
    elif p{"edge"} and platform::desktop(p)
        sw | switch_img("the toggle button")
        body |= """      <ol>
        <li>Click <em>Start</em>, then <em>Settings</em>.</li>
        <li>Go to <em>System &gt; Notification</em>.</li>
        <li>Click <em>{sw}</em> <em>ON</em> for Campfire.</li>
      </ol>
"""
    elif (p{"firefox"} or p{"chrome"}) and platform::desktop(p)
        if p{"windows"}
            sw | switch_img("the toggle button")
            body |= """      <ol>
          <li>Click <em>Start</em>, then <em>Settings</em>.</li>
          <li>Go to <em>System &gt; Notification</em>.</li>
          <li>Click <em>{sw}</em> <em>ON</em> for Campfire.</li>
      </ol>
"""
        else
            sw | switch_img("the allow notifications switch")
            body |= """      <ol>
          <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
          <li>Click <em>System Settings…</em>.</li>
          <li>Click <em>Notifications</em>.</li>
          <li>Click <em>Campfire</em>.</li>
          <li>Click <em>{sw}</em> to <em>Allow notifications</em>.</li>
      </ol>
"""
        xx
    elif p{"safari"} and platform::desktop(p)
        sw | switch_img("the allow notifications switch")
        body |= """      <ol>
        <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
        <li>Click <em>System Settings…</em>.</li>
        <li>Click <em>Notifications</em>.</li>
        <li>Click <em>Campfire</em>.</li>
        <li>Click <em>{sw}</em> to <em>Allow notifications</em>.</li>
      </ol>
"""
    elif (p{"safari"} or p{"chrome"}) and p{"ios"}
        sw | switch_img("the allow notifications switch button")
        body |= """      <ol>
        <li>Open the <em>{gear}</em> Settings app.</li>
        <li>Scroll to and tap <em>Campfire</em>.</li>
        <li>Tap <em>Notifications</em>.</li>
        <li>Tap <em>{sw}</em> to <em>Allow Notifications</em>.</li>
      </ol>
"""
    elif p{"chrome"} and p{"android"}
        sw | switch_img("the switch")
        body |= """      <ol>
        <li>Open the <em>{gear}</em> Settings app.</li>
        <li>Tap <em>Notifications</em>.</li>
        <li>Tap <em>App notifications</em>.</li>
        <li>Scroll to <em>Campfire</em>.</li>
        <li>Tap <em>{sw}</em> to <em>Allow Notifications</em>.</li>
      </ol>
"""
    else
        body |= """      <p>Ensure notifications are allowed for {browser} in your system settings.</p>
"""
    xx
    return """<details class="notifications-help hide-in-browser" data-notifications-target="details">
  <summary class="btn">
    {gear}
    <strong>Check your {os} settings</strong>
    {disclosure}
  </summary>

{body}</details>
"""
xx

act install_instructions(p)
    if p{"chrome"} or (p{"firefox"} and p{"android"} == false) => return ""
    install | html::img("external/install.svg", "aria-hidden=\"true\" ", 20)
    install_plain | html::img("external/install.svg", "aria-hidden=\"true\" ", 0)
    disclosure | html::img("disclosure.svg", "aria-hidden=\"true\" class=\"disclosure\" ", 10)
    browser | html::h(html::capitalize(p{"browser"}))
    os | html::h(p{"os"})
    body | ""
    if p{"edge"}
        edge | html::img("install-edge.svg", "alt=\"the app available - install Campfire chat button\" ", 16)
        body |= """        <ol>
          <li>Click <em>{edge}</em>in the address bar.</li>
          <li>Click <em>Install</em>.</li>
        </ol>
"""
    elif p{"chrome"} and p{"android"}
        dots | html::img("menu-dots-vertical.svg", "alt=\"More options\" ", 16)
        body |= """        <ol>
          <li>Tap the <em>{dots}</em> menu button.</li>
          <li>Tap <em>Install app</em> in the menu.</li>
        </ol>
"""
    elif p{"firefox"} and p{"android"}
        dots | html::img("menu-dots-vertical.svg", "alt=\"More options\" ", 16)
        body |= """        <ol>
          <li>Tap the <em>{dots}</em> menu button.</li>
          <li>Tap <em>Install</em> in the menu.</li>
        </ol>
"""
    elif p{"safari"} and platform::desktop(p)
        body |= """        <ol>
          <li>Click <em>File</em> in the top left.</li>
          <li>Click <em>Add to Dock…</em>.</li>
        </ol>
"""
    elif (p{"safari"} or p{"chrome"}) and p{"ios"}
        share | html::img("external/share.svg", "alt=\"the share button\" ", 20)
        body |= """        <p>To receive push notifications in {browser} for {os}, you must install Campfire as a web app.</p>
        <ol>
          <li>Tap <em>{share}</em></li>
          <li>Tap <em>Add to Home Screen</em>.</li>
        </ol>
"""
    else
        body |= """        <p>Some platforms require you to install Campfire as a web app to receive push notifications.</p>
"""
    xx
    return """  <details class="notifications-help pwa__instructions hide-in-pwa" data-controller="pwa-install" data-pwa-install-prompting-class="pwa--can-install" data-notifications-target="details">
    <summary class="btn">
      {install}
      <strong>Install Campfire as a web app.</strong>
      {disclosure}
    </summary>

{body}
    <div class="margin-block-start txt-align-center pwa__installer">
      <hr class="separator margin-block">
      <button class="btn btn--reversed center" data-action="pwa-install#promptInstall">
        {install_plain}
        Install now
      </button>
    </div>
  </details>
"""
xx
