/// lib/views/users.gbln
/// users/show, users/_ban_button, users/profiles/_transfer and the
/// autocompletable users partials.

import lib/html as html
import lib/platform as platform
import lib/views/pwa as pwa

/// link_back: the referrer, unless there is none or it is this page.
act link_back(c)
    req | c["req"]
    back | http_header_referrer(req)
    if back == "" or back == req["base"] + req["path"] + query_suffix(req) => back |= "/"
    arrow | html::img("arrow-left.svg", "aria-hidden=\"true\" ", 20)
    href | html::h(back)
    return "<a class=\"btn\" href=\"{href}\">{arrow}<span class=\"for-screen-reader\">Go Back</span></a>"
xx

act http_header_referrer(req)
    if :has(req, "referrer") => return req["referrer"]
    return ""
xx

act query_suffix(req)
    if req["query"] == "" => return ""
    return "?" + req["query"]
xx

/// users/profiles/_transfer
act transfer(c, user, url, qr_id)
    laptop | html::img("laptop.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 36)
    arrows | html::img("transfer.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 36)
    phone | html::img("mobile-phone.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 36)
    label | ""
    if c["user"]["id"] != user["id"]
        crown | html::img("crown.svg", "aria-hidden=\"true\" class=\"flex-item-no-shrink colorize--black\" ", 16)
        label |= """      <div class="flex align-center gap justify-center">
        {crown}
        <label for="session_transfer_url">Share to get them back into their account</label>
      </div>
"""
    else
        label |= "      <label for=\"session_transfer_url\" class=\"for-screen-reader\">Use this link to login automatically on another device</label>\n"
    xx
    qr | html::img("qr-code.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 20)
    copy | html::img("copy-paste.svg", "aria-hidden=\"true\" class=\"flex-item-no-shrink colorize--black\" ", 20)
    share | html::img("share.svg", "aria-hidden=\"true\" class=\"flex-item-no-shrink colorize--black\" ", 20)
    return """
<fieldset>
  <legend class="gap">
    {laptop}
    {arrows}
    {phone}
  </legend>


  <div class="flex flex-column gap">
{label}
    <input type="text" class="input" value="{url}" id="session_transfer_url" readonly>

    <div class="flex align-center center gap">
      <a class="btn" data-lightbox-target="image" data-action="lightbox#open" data-lightbox-url-value="/qr_code/{qr_id}" href="/qr_code/{qr_id}">
        <span class="for-screen-reader">Show auto-login QR code</span>
        {qr}
</a>
      <button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="{url}">
        <span class="for-screen-reader">Copy auto-login link</span>
        {copy}
</button>
      <button class="btn" hidden="hidden" data-controller="web-share" data-action="web-share#share" data-web-share-url-value="{url}" data-web-share-text-value="This is your own private sign-in URL, DO NOT SHARE IT. Use it to sign-in on another device or if you get locked out." data-web-share-title-value="Your sign-in link">
        <span class="for-screen-reader">Share auto-login link</span>
        {share}
</button>    </div>
  </div>
</fieldset>
"""
xx

/// users/_ban_button
act ban_button(c, user)
    id | user["id"]
    name | html::h(user["name"])
    cancel_img | ""
    if user["status"] == 0
        cancel_img |= html::img("cancel.svg", "aria-hidden=\"true\" aria-label=\"Ban {name}\" ", 0)
        return "  " + html::button_to("/users/{id}/ban", "post", "", " class=\"btn full-width\" data-turbo-confirm=\"Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses.\"", "\n    {cancel_img}\n    <span>Ban {name}</span>\n", c["csrf"])
    xx
    cancel_img |= html::img("cancel.svg", "aria-hidden=\"true\" aria-label=\"Remove Ban {name}\" ", 0)
    return "  " + html::button_to("/users/{id}/ban", "delete", "", " class=\"btn btn--negative full-width\" data-turbo-confirm=\"Are you sure you want to remove the ban on this user?\"", "\n    {cancel_img}\n    <span>Remove ban</span>\n", c["csrf"])
xx

/// users/show's nav
act show_nav(c, user)
    back | link_back(c)
    edit | ""
    if c["user"]["id"] == user["id"]
        pencil | html::img("pencil.svg", "aria-hidden=\"true\" ", 0)
        edit |= "      <a class=\"btn\" href=\"/users/me/profile\">\n        {pencil}\n        <span class=\"for-screen-reader\">Edit my profile</span>\n</a>"
    xx
    return "  <div class=\"flex-item-justify-start\">\n    {back}\n  </div>\n\n  <div class=\"flex align-center gap flex-item-justify-end\">\n{edit}  </div>\n"
xx

/// users/show; `data` carries the user, its transfer URL and QR code id.
act show(c, data)
    user | data["user"]
    me | c["user"]
    admin | me["role"] == 1
    id | user["id"]
    name | html::h(user["name"])
    status | user["status"]
    banned | ""
    if status == 2 => banned |= "banned"
    avatar | html::img_src(user["avatar"], "alt=\"Profile avatar\" class=\"avatar\" ", 0)
    out | "\n\n<section class=\"panel txt-align-center\">\n  <div class=\"flex flex-column gap {banned}\">\n    <div class=\"avatar txt-xx-large center\" style=\"background: white\">\n      {avatar}\n    </div>\n\n"
    if user["role"] == 2
        out |= out + "      <div class=\"pad-double--inline push--inline push--block-start\">\n"
        if status == 0
            msg | html::img("messages.svg", "", 0)
            out |= out + "          " + html::button_to("/rooms/directs?user_ids%5B%5D={id}", "post", "", " class=\"btn btn--primary full-width txt--large\"", msg, c["csrf"]) + "\n"
        else
            out |= out + "          <div>{name} is no longer on this account</div>\n"
        xx
        out |= out + "      </div>\n"
    elif status != 1
        out |= out + "        <div class=\"flex flex-column gap\" style=\"--row-gap: calc(var(--block-space) / 3)\">\n          <h1 class=\"txt-x-large txt-tight-lines margin-none\">{name}</h1>\n"
        if admin
            email | html::h(user["email_address"])
            out |= out + "            <div><a href=\"mailto:{email}\">{email}</a></div>\n"
        xx
        bio | ""
        if user["bio"] != nil => bio |= html::h(user["bio"])
        out |= out + "          <div>{bio}</div>\n        </div>\n\n"
        if status == 0
            msg | html::img("messages.svg", "aria-hidden=\"true\" aria-label=\"Ping {name}\" ", 0)
            out |= out + "          <div class=\"pad-inline-double margin-inline margin-block-start\">\n            " + html::button_to("/rooms/directs?user_ids%5B%5D={id}", "post", "", " class=\"btn btn--reversed full-width txt-large\"", "\n              {msg}\n", c["csrf"]) + "          </div>\n\n"
            if admin
                out |= out + "            <hr class=\"margin-block-start borderless\">\n\n            " + transfer(c, user, data["transfer_url"], data["qr_id"]) + "\n"
            xx
        xx
        out |= out + "\n"
        if admin and me["id"] != id
            out |= out + "          <div class=\"margin-block-start\">\n            " + ban_button(c, user) + "\n          </div>\n"
        xx
    else
        out |= out + "        <div>\n          <h1 class=\"txt-x-large margin-none\">{name}</h1>\n          <div>{name} is no longer on this account</div>\n        </div>\n"
    xx
    return out + "  </div>\n</section>\n"
xx

/// users/_mention
act mention(u)
    sgid | u["sgid"]
    avatar | html::avatar_tag(u, "")
    name | html::h(u["name"])
    return "<span class=\"mention\" sgid=\"{sgid}\">{avatar} {name}</span>"
xx

/// autocompletable/users/_prompt_item
act prompt_item(u)
    name | html::h(u["name"])
    sgid | u["sgid"]
    avatar | html::avatar_tag(u, "")
    m | mention(u)
    return """<lexxy-prompt-item search="{name}" sgid="{sgid}">
  <template type="menu">
    <span class="autocomplete__item flex align-center gap unpad">
      {avatar}
      <span class="autocompletable__name">{name}</span>
    </span>
  </template>
  <template type="editor">
    {m}

  </template>
</lexxy-prompt-item>
"""
xx

/// ---------- users/profiles ----------

act profile_nav(c)
    back | link_back(c)
    token | html::hidden_token(c["csrf"])
    logout | html::img("logout.svg", "aria-hidden=\"true\" ", 0)
    return """  <div class="flex-item-justify-start">
    {back}
  </div>

  <div class="flex-item-justify-end">
    <form data-controller="sessions" action="/session" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="delete" />{token}
      <input type="hidden" name="push_subscription_endpoint" id="push_subscription_endpoint" data-sessions-target="pushSubscriptionEndpoint" />

      <button class="btn" data-action="sessions#logout:prevent">
        {logout}
        <span class="for-screen-reader">Log out</span>
      </button>
</form>  </div>
"""
xx

/// profile_form_with: `attrs` go before data-controller, `multipart` adds
/// the enctype a file field brings.
act profile_form_open(c, attrs, multipart)
    token | html::hidden_token(c["csrf"])
    enc | ""
    if multipart => enc |= " enctype=\"multipart/form-data\""
    return "<form {attrs}data-controller=\"form\"{enc} action=\"/users/me/profile\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"_method\" value=\"patch\" />{token}"
xx

act avatar_file_field()
    return "<input id=\"file\" class=\"input\" accept=\"image/*\" data-upload-preview-target=\"input\" data-action=\"upload-preview#previewImage change-&gt;form#submit\" type=\"file\" name=\"user[avatar]\" />"
xx

/// users/profiles/_membership
act profile_membership(c, mb)
    id | mb["room_id"]
    name | html::h(mb["display_name"])
    key | html::room_key({"id": id, "type": mb["type"]})
    button | mb["button"]
    return """<li class="flex align-center gap margin-none min-width membership-item">
  <a class="overflow-ellipsis fill-shade txt-primary txt-undecorated" href="/rooms/{id}">
    <strong>{name}</strong>
</a>
  <hr class="separator" aria-hidden="true">

  <span class="txt-small">
    <turbo-frame id="involvement_{key}">
      {button}
</turbo-frame>  </span>
</li>
"""
xx

/// users/profiles/show
act profile(c, data, shared, directs)
    user | data["user"]
    id | user["id"]
    install | pwa::install_instructions(platform::parse(c["req"]["user_agent"]))
    camera | html::img("camera.svg", "aria-hidden=\"true\" ", 20)
    file | avatar_file_field()
    form1 | profile_form_open(c, "class=\"txt-medium\" ", true)
    form2 | profile_form_open(c, "", true)
    form3 | profile_form_open(c, "", false)
    avatar | html::img_src(user["avatar"], "aria-hidden=\"true\" data-upload-preview-target=\"image\" ", 300)
    delete_avatar | ""
    if data["has_avatar"]
        minus | html::img("minus.svg", "aria-hidden=\"true\" ", 20)
        delete_avatar |= "      " + html::button_to("/users/{id}/avatar", "delete", "", " class=\"btn btn--negative txt-small avatar__delete-btn\"", "\n        {minus}\n        <span class=\"for-screen-reader\">Delete avatar</span>\n", c["csrf"])
    xx
    tr_name | html::translation_button("user_name")
    tr_email | html::translation_button("email_address")
    tr_password | html::translation_button("update_password")
    tr_bio | html::translation_button("bio")
    name | html::h(user["name"])
    email_value | ""
    if user["email_address"] != nil
        ev | html::h(user["email_address"])
        email_value |= " value=\"{ev}\""
    xx
    bio | ""
    if user["bio"] != nil => bio |= html::h(user["bio"])
    person | html::img("person.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 24)
    email_img | html::img("email.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 24)
    password_img | html::img("password.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 24)
    bio_img | html::img("bio.svg", "aria-hidden=\"true\" class=\"colorize--black\" ", 24)
    check | html::img("check.svg", "aria-hidden=\"true\" ", 20)
    list | "      "
    for mb in shared
        list |= list + profile_membership(c, mb)
    xx
    list |= list + "\n\n"
    if :len(shared) > 0 and :len(directs) > 0
        list |= list + "        <hr class=\"separator full-width\" style=\"--border-style: solid\">\n"
    xx
    list |= list + "\n      "
    for mb in directs
        list |= list + profile_membership(c, mb)
    xx
    xfer | transfer(c, user, data["transfer_url"], data["qr_id"])
    return """

<section class="panel flex flex-column gap" style="view-transition-name: avatar-{id}">
  {install}

  <div class="align-center center avatar__form gap" data-controller="upload-preview">
    {form1}
      <label class="btn input--file">
        {camera}
        {file}
        <span class="for-screen-reader">Upload avatar</span>
      </label>
</form>
    {form2}
      <label class="btn avatar input--file txt-xx-large">
        {avatar}
        {file}
        <span class="for-screen-reader">Avatar</span>
      </label>
</form>
{delete_avatar}  </div>

  {form3}
    <div class="flex flex-column gap">
      <div class="flex align-center gap">
        {tr_name}

        <label class="flex align-center gap flex-item-grow input input--actor">
          <input class="input txt-large " autocomplete="name" placeholder="Enter your name" autofocus="autofocus" required="required" data-1p-ignore="true" type="text" value="{name}" name="user[name]" id="user_name" />
          {person}
        </label>
      </div>

      <div class="flex align-center gap">
        {tr_email}

        <label class="flex align-center gap flex-item-grow input input--actor">
          <input class="input txt-large"{email_value} autocomplete="username" placeholder="Enter your email address" type="email" name="user[email_address]" id="user_email_address" />
          {email_img}
        </label>
      </div>

      <div class="flex align-center gap">
        {tr_password}

        <label class="flex align-center gap flex-item-grow input input--actor">
          <input class="input txt-large" autocomplete="new-password" placeholder="Change password" maxlength="72" size="72" type="password" name="user[password]" id="user_password" />
          {password_img}
        </label>
      </div>

      <div class="flex align-start gap">
        {tr_bio}

        <label class="flex align--center gap flex-item--grow input input--actor">
          <textarea class="input txt-large" placeholder="A few words about yourself…" maxlength="200" rows="3" name="user[bio]" id="user_bio">
{bio}</textarea>
          {bio_img}
        </label>
      </div>

      <button class="btn btn--reversed center txt-large" type="submit">{check}<span class="for-screen-reader">Save changes</span></button>
    </div>
</form>
  <div class="margin-block pad-inline pad-block fill-shade border-radius">
    <menu class="flex flex-column gap margin-none pad">
{list}
    </menu>
  </div>

  {xfer}

</section>
"""
xx

/// ---------- users/push_subscriptions ----------

/// UserAgent.parse(ua): browser, version and platform, as the useragent gem
/// reports them for the browsers Campfire supports.
act user_agent(ua)
    s | ua
    if s == nil => s |= ""
    browser | "Unknown"
    version | ""
    tokens | [["Edg", "Edge"], ["OPR", "Opera"], ["Firefox", "Firefox"], ["Chrome", "Chrome"], ["CriOS", "Chrome"], ["FxiOS", "Firefox"]]
    for t in tokens
        if browser == "Unknown"
            found | html::matches(s, t[0] + "/[0-9A-Za-z._]+")
            if :len(found) > 0
                browser |= t[1]
                version |= :split(found[0], "/")[1]
            xx
        xx
    xx
    if browser == "Unknown" and :has(s, "Safari")
        browser |= "Safari"
        found | html::matches(s, "Version/[0-9A-Za-z._]+")
        if :len(found) > 0 => version |= :split(found[0], "/")[1]
    xx
    platform | "Unknown"
    pairs | [["iPhone", "iPhone"], ["iPad", "iPad"], ["Android", "Android"], ["Macintosh", "Macintosh"], ["Windows", "Windows"], ["CrOS", "ChromeOS"], ["Linux", "Linux"], ["X11", "X11"]]
    for pr in pairs
        if platform == "Unknown" and :has(s, pr[0]) => platform |= pr[1]
    xx
    return {"browser": browser, "version": version, "platform": platform}
xx

/// users/push_subscriptions/_push_subscription
act push_subscription(c, sub)
    id | sub["id"]
    agent | user_agent(sub["user_agent"])
    label | html::h(agent["browser"] + " " + agent["version"] + " on " + agent["platform"])
    endpoint | ""
    if sub["endpoint"] != nil => endpoint |= html::h(sub["endpoint"])
    bell | html::img("notification-bell-everything.svg", "aria-hidden=\"true\" ", 20)
    minus | html::img("minus.svg", "aria-hidden=\"true\" ", 20)
    test | html::button_to("/users/me/push_subscriptions/{id}/test_notifications", "post", "", " class=\"btn btn--reversed\"", "\n        {bell}\n        <span class=\"for-screen-reader\">Send test notification</span>\n", c["csrf"])
    remove | html::button_to("/users/me/push_subscriptions/{id}", "delete", "", " class=\"btn btn--negative\"", "\n        {minus}\n        <span class=\"for-screen-reader\">Delete subscription</span>\n", c["csrf"])
    return """<li class="flex flex-column margin-none membership-item">
  <span class="overflow-ellipsis txt-primary txt-undecorated">
    <strong>{label}</strong><br>
  </span>

  <span class="flex align-start gap txt-small">
    <span>{endpoint}</span>

    <span class="flex align-center gap">
      {test}
      {remove}    </span>
  </span>
</li>
"""
xx

act push_subscriptions(c, subs)
    list | ""
    for sub in subs
        list |= list + push_subscription(c, sub)
    xx
    return """

<section class="panel panel--wide flex flex-column gap">
  <h1 class="txt-align-center txt-large margin-none">Push Notification Subscriptions</h1>
  <div class="pad-inline fill-shade border-radius" id="push_subscriptions">
    <menu class="pad flex flex-column gap">
      {list}
    </menu>
  </div>
</section>
"""
xx
