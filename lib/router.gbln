/// lib/router.gbln
/// config/routes.rb and ApplicationController's before_actions.

import lib/http as http
import lib/auth as auth
import lib/db as db
import lib/html as html
import lib/platform as platform
import lib/controllers/sessions as sessions
import lib/controllers/rooms as rooms
import lib/controllers/room_admin as room_admin
import lib/controllers/users as users_ctl
import lib/controllers/accounts as accounts
import lib/controllers/onboarding as onboarding
import lib/controllers/messages as messages
import lib/controllers/sidebars as sidebars
import lib/controllers/searches as searches
import lib/controllers/cable as cable_endpoint
import lib/controllers/files as files
import lib/controllers/room_parts as room_parts
import lib/controllers/pwa as pwa_ctl
import lib/controllers/boosts as boosts
import lib/controllers/bot_api as bot_api
import lib/controllers/blobs as blobs


act not_found(c)
    return http::error_page(404)
xx

act forbidden()
    return http::head(403)
xx

/// Splits "/rooms/1/messages" into ["rooms", "1", "messages"], dropping a
/// trailing ".json" / ".html" format into the second slot of the result.
act segments(path)
    out | []
    for s in :split(path, "/")
        if s != "" => :put_last!(out, http::url_decode(s))
    xx
    return out
xx

act strip_format(s)
    if :ends_with(s, ".json") or :ends_with(s, ".html") => return html::chop(s, 5)
    return s
xx

/// require_authentication's fallback: remember where to come back to.
act request_authentication(c)
    req | c["req"]
    res | http::redirect(req, "/session/new")
    url | req["base"] + req["path"]
    if req["query"] != "" => url |= url + "?" + req["query"]
    res |= http::add_cookie(res, "return_to", http::url_encode(url), "; path=/; httponly; samesite=lax")
    return res
xx

act dispatch(c)
    req | c["req"]
    m | req["method"]
    s | segments(req["path"])
    n | :len(s)

    /// Rails::HealthController -- outside ApplicationController.
    if n == 1 and s[0] == "up"
        return http::html("<!DOCTYPE html><html><body style=\"background-color: green\"></body></html>")
    xx

    /// ActionCable's mount point: authenticated by the session cookie and an
    /// origin check, outside ApplicationController's before_actions.
    if n == 1 and s[0] == "cable" and m == "POST" => return cable_endpoint::handle(c)

    p | platform::parse(req["user_agent"])
    if platform::allowed(p) == false => return http::text(406, "Your browser is not supported. Please upgrade.")

    if m != "GET" and m != "HEAD"
        if auth::verified_request(c) == false => return http::error_page(422)
        banned | db::value("select count(*)::int as n from bans where ip_address = $1", [req["ip"]])
        if banned > 0 => return http::head(429)
    xx

    /// ---- routes that allow unauthenticated access ----
    if n == 2 and s[0] == "session" and s[1] == "new" and m == "GET" => return sessions::new(c)
    if n == 1 and s[0] == "session" and m == "POST" => return sessions::create(c)
    if n == 2 and s[0] == "account" and s[1] == "logo" and m == "GET" => return files::logo(c)
    if n == 1 and s[0] == "first_run" and m == "GET" => return onboarding::first_run(c)
    if n == 1 and s[0] == "first_run" and m == "POST" => return onboarding::create_first_run(c)
    if n == 2 and s[0] == "join" and m == "GET" => return onboarding::join(c, s[1])
    if n == 2 and s[0] == "join" and m == "POST" => return onboarding::create_user(c, s[1])
    if n == 3 and s[0] == "session" and s[1] == "transfers" and m == "GET" => return onboarding::transfer(c, s[2])
    if n == 3 and s[0] == "session" and s[1] == "transfers" and (m == "PUT" or m == "PATCH") => return onboarding::update_transfer(c, s[2])
    if n == 1 and (s[0] == "webmanifest" or s[0] == "webmanifest.json") and m == "GET" => return pwa_ctl::manifest(c)
    if n == 1 and (s[0] == "service-worker" or s[0] == "service-worker.js") and m == "GET" => return pwa_ctl::service_worker(c)

    /// ActiveStorage's engine routes, mounted outside ApplicationController
    if n >= 4 and s[0] == "rails" and s[1] == "active_storage" and m == "GET"
        if s[2] == "blobs" and s[3] == "redirect" and n >= 5 => return blobs::show(c, s[4])
        if s[2] == "representations" and s[3] == "redirect" and n >= 6 => return blobs::representation(c, s[4], s[5])
        if s[2] == "disk" and n >= 4 => return blobs::disk(c, s[3])
    xx

    /// ---- everything else requires a signed-in user ----
    if auth::signed_in(c) == false => return request_authentication(c)
    /// Messages::ByBotsController and Messages::Boosts::ByBotsController
    if n >= 4 and s[0] == "rooms" and s[3] == "messages" and s[2] != "messages"
        if n == 4 and m == "GET" => return bot_api::index(c, s[1], s[2])
        if n == 4 and m == "POST" => return bot_api::create(c, s[1])
        if n == 5 and (m == "PATCH" or m == "PUT") => return bot_api::update(c, s[1], s[4])
        if n == 5 and m == "DELETE" => return bot_api::destroy(c, s[1], s[4])
        if n == 6 and s[5] == "boosts" and m == "POST" => return bot_api::create_boost(c, s[1], s[4])
        if n == 7 and s[5] == "boosts" and m == "DELETE" => return bot_api::destroy_boost(c, s[1], s[4], s[6])
    xx
    bot | c["authenticated_by"] == "bot_key"
    if bot => return forbidden()

    if n == 1 and s[0] == "session" and m == "DELETE" => return sessions::destroy(c)

    if n == 0 => return rooms::root(c)
    if n == 3 and s[0] == "users" and s[2] == "avatar" and m == "GET" => return files::avatar(c, s[1])

    if s[0] == "rooms" and n >= 2 and (s[1] == "opens" or s[1] == "closeds" or s[1] == "directs")
        kind | s[1]
        if n == 3 and s[2] == "new" and m == "GET"
            if kind == "opens" => return room_admin::new_open(c)
            if kind == "closeds" => return room_admin::new_closed(c)
            return room_admin::new_direct(c)
        xx
        if n == 2 and m == "POST"
            if kind == "opens" => return room_admin::create_open(c)
            if kind == "closeds" => return room_admin::create_closed(c)
            return room_admin::create_direct(c)
        xx
        if n == 4 and s[3] == "edit" and m == "GET"
            if kind == "opens" => return room_admin::edit_open(c, s[2])
            if kind == "closeds" => return room_admin::edit_closed(c, s[2])
            return room_admin::edit_direct(c, s[2])
        xx
        if n == 3 and (m == "PATCH" or m == "PUT")
            if kind == "opens" => return room_admin::update_open(c, s[2])
            if kind == "closeds" => return room_admin::update_closed(c, s[2])
        xx
        if n == 3 and m == "GET" and kind != "directs" => return room_admin::show(c, s[2])
        if n == 3 and m == "DELETE" and kind == "directs" => return room_admin::destroy_direct(c, s[2])
        return not_found(c)
    xx

    if s[0] == "rooms"
        if n == 1 and m == "GET" => return rooms::index(c)
        if n == 2 and m == "GET" => return rooms::show(c, s[1], "")
        if n == 2 and m == "DELETE" => return rooms::destroy(c, s[1])
        if n == 3 and m == "GET" and :starts_with(s[2], "@") => return rooms::show(c, s[1], s[2][1:])
        if n >= 3 and s[2] == "messages"
            room_id | s[1]
            if n == 3 and m == "GET" => return messages::index(c, room_id)
            if n == 3 and m == "POST" => return messages::create(c, room_id)
            if n == 4 and m == "GET" => return messages::show(c, room_id, s[3])
            if n == 5 and m == "GET" and s[4] == "edit" => return messages::edit(c, room_id, s[3])
            if n == 4 and (m == "PATCH" or m == "PUT") => return messages::update(c, room_id, s[3])
            if n == 4 and m == "DELETE" => return messages::destroy(c, room_id, s[3])
        xx
        if n == 3 and s[2] == "refresh" and m == "GET" => return room_parts::refresh(c, s[1])
        if n == 3 and s[2] == "involvement" and m == "GET" => return room_parts::involvement(c, s[1])
        if n == 3 and s[2] == "involvement" and (m == "PUT" or m == "PATCH") => return room_parts::update_involvement(c, s[1])
        return not_found(c)
    xx

    if n == 3 and s[0] == "users" and s[1] == "me" and s[2] == "sidebar" and m == "GET" => return sidebars::show(c)
    if n == 3 and s[0] == "users" and s[1] == "me" and s[2] == "profile" and m == "GET" => return users_ctl::profile(c)
    if n == 3 and s[0] == "users" and s[1] == "me" and s[2] == "profile" and (m == "PATCH" or m == "PUT") => return users_ctl::update_profile(c)
    if n >= 1 and (s[0] == "account" or :starts_with(s[0], "account."))
        if n == 1 and (m == "PATCH" or m == "PUT") => return accounts::update(c)
        if n == 2 and s[1] == "edit" and m == "GET" => return accounts::edit(c)
        if n == 2 and (s[1] == "users" or s[1] == "users.turbo_stream") and m == "GET" => return accounts::users_index(c)
        if n == 3 and s[1] == "users" and (m == "PATCH" or m == "PUT") => return accounts::update_user(c, s[2])
        if n == 3 and s[1] == "users" and m == "DELETE" => return accounts::destroy_user(c, s[2])
        if n == 2 and s[1] == "join_code" and m == "POST" => return accounts::reset_join_code(c)
        if n == 3 and s[1] == "custom_styles" and s[2] == "edit" and m == "GET" => return accounts::edit_custom_styles(c)
        if n == 2 and s[1] == "custom_styles" and (m == "PATCH" or m == "PUT") => return accounts::update_custom_styles(c)
        if n == 2 and s[1] == "logo" and m == "DELETE" => return accounts::destroy_logo(c)
        if n >= 2 and s[1] == "bots"
            if n == 2 and m == "GET" => return accounts::bots(c)
            if n == 2 and m == "POST" => return accounts::create_bot(c)
            if n == 3 and s[2] == "new" and m == "GET" => return accounts::new_bot(c)
            if n == 4 and s[3] == "edit" and m == "GET" => return accounts::edit_bot(c, s[2])
            if n == 3 and (m == "PATCH" or m == "PUT") => return accounts::update_bot(c, s[2])
            if n == 3 and m == "DELETE" => return accounts::destroy_bot(c, s[2])
            if n == 4 and s[3] == "key" and (m == "PATCH" or m == "PUT") => return accounts::reset_bot_key(c, s[2])
        xx
        return not_found(c)
    xx

    if n >= 3 and s[0] == "users" and s[1] == "me" and s[2] == "push_subscriptions"
        if n == 3 and m == "GET" => return users_ctl::push_subscriptions(c)
        if n == 3 and m == "POST" => return users_ctl::create_push_subscription(c)
        if n == 4 and m == "DELETE" => return users_ctl::destroy_push_subscription(c, s[3])
        if n == 5 and s[4] == "test_notifications" and m == "POST" => return users_ctl::test_push_notification(c, s[3])
    xx
    if n == 2 and s[0] == "users" and m == "GET" => return users_ctl::show(c, s[1])
    if n == 3 and s[0] == "users" and s[2] == "ban" and m == "POST" => return users_ctl::ban(c, s[1])
    if n == 3 and s[0] == "users" and s[2] == "ban" and m == "DELETE" => return users_ctl::unban(c, s[1])
    if n == 2 and s[0] == "autocompletable" and s[1] == "users" and m == "GET" => return users_ctl::autocomplete(c)

    if s[0] == "messages" and n >= 3 and s[2] == "boosts"
        if n == 3 and m == "GET" => return boosts::index(c, s[1])
        if n == 3 and m == "POST" => return boosts::create(c, s[1])
        if n == 4 and s[3] == "new" and m == "GET" => return boosts::new(c, s[1])
        if n == 4 and m == "DELETE" => return boosts::destroy(c, s[1], s[3])
    xx

    if s[0] == "searches"
        if n == 1 and m == "GET" => return searches::index(c)
        if n == 1 and m == "POST" => return searches::create(c)
        if n == 2 and s[1] == "clear" and m == "DELETE" => return searches::clear(c)
    xx

    return not_found(c)
xx
