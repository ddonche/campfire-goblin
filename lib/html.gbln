/// lib/html.gbln
/// HTML helpers shared by the views: escaping, asset tags and the small
/// Rails view helpers Campfire's templates lean on.

import lib/assets as assets

act h(s)
    if s == nil => return ""
    return :escape_html(:str(s))
xx

/// s without its last n characters
act chop(s, n)
    k | :len(s) - n
    if k <= 0 => return ""
    return s[0:k]
xx

act asset(name)
    return assets::path(name)
xx

/// image_tag with Rails' attribute order: the given attributes, then src,
/// then width/height when a size is given (size 0 means none).
act img(name, attrs, size)
    src | asset(name)
    if size == 0 => return "<img {attrs}src=\"{src}\" />"
    return "<img {attrs}src=\"{src}\" width=\"{size}\" height=\"{size}\" />"
xx

act img_src(src, attrs, size)
    if size == 0 => return "<img {attrs}src=\"{src}\" />"
    return "<img {attrs}src=\"{src}\" width=\"{size}\" height=\"{size}\" />"
xx

/// Rails' tag.time datetime: ..., data: { local_time_target: style }
act local_time(iso, style, klass)
    if klass == "" => return "<time datetime=\"{iso}\" data-local-time-target=\"{style}\"></time>"
    return "<time class=\"{klass}\" datetime=\"{iso}\" data-local-time-target=\"{style}\"></time>"
xx

/// Forms rendered for Turbo Stream responses and broadcasts carry no token
/// (Turbo sends X-CSRF-Token from the page's meta tag), signalled by nil.
act hidden_token(token)
    if token == nil => return ""
    return "<input type=\"hidden\" name=\"authenticity_token\" value=\"{token}\" />"
xx

/// Rails' button_to: a one-button form; non-POST methods ride in _method.
act button_to(url, method, form_attrs, button_attrs, inner, token)
    m | ""
    if method != "post" => m |= "<input type=\"hidden\" name=\"_method\" value=\"{method}\" />"
    return "<form class=\"button_to\" method=\"post\" action=\"{url}\"{form_attrs}>{m}<button{button_attrs} type=\"submit\">{inner}</button>" + hidden_token(token) + "</form>"
xx

act dom_id(prefix, kind, id)
    if prefix == "" => return kind + "_" + :str(id)
    return prefix + "_" + kind + "_" + :str(id)
xx

/// Room#to_key for STI rooms: rooms_open_1, rooms_closed_1, rooms_direct_1
act room_key(room)
    t | room["type"]
    if t == "Rooms::Open" => return "rooms_open_" + :str(room["id"])
    if t == "Rooms::Closed" => return "rooms_closed_" + :str(room["id"])
    return "rooms_direct_" + :str(room["id"])
xx

/// Array#to_sentence
act to_sentence(phrases, two_words)
    n | :len(phrases)
    if n == 0 => return ""
    if n == 1 => return phrases[0]
    if n == 2 => return phrases[0] + two_words + phrases[1]
    out | ""
    i | 0
    while i < n - 1
        if i > 0 => out |= out + ", "
        out |= out + phrases[i]
        i |= i + 1
    xx
    return out + ", and " + phrases[n - 1]
xx

act capitalize(s)
    if s == "" => return s
    return :upper(s[0:1]) + :lower(s[1:])
xx

