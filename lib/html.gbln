act translation_button(key)
    globe | img("globe.svg", "aria-hidden=\"true\" class=\"color-icon\" ", 20)
    list | ""
    texts | TRANSLATIONS[key]
    i | 0
    for flag in FLAGS
        t | h(texts[i])
        list |= list + "<dt>{flag}</dt><dd class=\"margin-none\">{t}</dd>"
        i |= i + 1
    xx
    return "<details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\"><summary class=\"btn\" tabindex=\"-1\">{globe}<span class=\"for-screen-reader\">Translate</span></summary><div class=\"language-list-menu shadow\" data-popup-target=\"menu\"><dl class=\"language-list\">{list}</dl></div></details>"
xx

/// ---------- avatars ----------

/// avatar_tag(user): link to the profile wrapping the avatar image.
act avatar_tag(user, extra)
    id | user["id"]
    title | h(user["title"])
    src | user["avatar"]
    return "<a title=\"{title}\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"/users/{id}\"><img aria-hidden=\"true\" {extra}src=\"{src}\" width=\"48\" height=\"48\" /></a>"
xx

act account_logo_tag(account, style)
    v | account["v"]
    return "<figure class=\"account-logo avatar {style}\"><img alt=\"Account logo\" src=\"/account/logo?v={v}\" width=\"300\" height=\"300\" /></figure>"
xx

/// :get_matching raises when nothing matches; this returns [] instead.
act matches(s, pattern)
    if :is_matching(s, pattern) == false => return []
    return :get_matching(s, pattern)
xx
