/// lib/cable.gbln -- ActionCable.server.broadcast and Turbo's broadcast_*_to.
///
/// Broadcasts go to the `realtime` hub actor that config/startup.gbln starts
/// (lib/realtime.gbln); the /cable long poll waits on it. Each message is the
/// one ActionCable would send to subscribers.

act broadcast(stream, message)
    :post(realtime, {"broadcast": [stream], "message": message})
    return nil
xx

/// One message for many streams (a fan-out to each member, say).
act broadcast_many(streams, message)
    if :len(streams) == 0 => return nil
    :post(realtime, {"broadcast": streams, "message": message})
    return nil
xx

/// The newest broadcast id: where a new subscription starts reading.
act cursor()
    reply | :channel(1)
    :post(realtime, {"cursor": true, "reply": reply})
    return :receive(reply, 10s)
xx

/// The broadcasts after each sub's "since" on its stream, waiting up to
/// `limit` for the first one. subs: [{"i", "stream", "since"}, ...]
act wait(subs, limit)
    reply | :channel(1)
    :post(realtime, {"wait": subs, "reply": reply})
    found | :receive(reply, limit)
    if found == nil
        :post(realtime, {"forget": reply})
        return []
    xx
    return found
xx

/// turbo_stream_action_tag with extra attributes (written before action and
/// target, as tag.turbo_stream writes them), e.g. maintain_scroll="true".
act stream_tag_with(attrs, verb, target, template)
    tag | stream_tag(verb, target, template)
    return "<turbo-stream " + attrs + " " + tag[14:]
xx

/// turbo_stream_action_tag
act stream_tag(verb, target, template)
    if template == nil => return "<turbo-stream action=\"{verb}\" target=\"{target}\"></turbo-stream>"
    return "<turbo-stream action=\"{verb}\" target=\"{target}\"><template>{template}</template></turbo-stream>"
xx
