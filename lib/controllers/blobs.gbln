/// lib/controllers/blobs.gbln
/// ActiveStorage::Blobs::RedirectController,
/// ActiveStorage::Representations::RedirectController and
/// ActiveStorage::DiskController#show: the three routes an attachment's URL
/// goes through. The first two redirect to a five-minute signed disk URL;
/// the third serves the file (through nginx).

import lib/http as http
import lib/db as db
import lib/storage as storage
import lib/webhooks as webhooks
import lib/multipart as multipart

/// Blob.find_signed!(id, purpose: :blob_id)
act find_blob(signed_id)
    id | db::value("select campfire_as_verified($1, 'blob_id') as v", [signed_id])
    if id == nil or :is_matching(id, "^[0-9]+$") == false => return nil
    return storage::by_id(:int(id))
xx

act expires(res)
    :update!(res{"headers"}{"Cache-Control"}, "max-age=300, private")
    return res
xx

/// GET /rails/active_storage/blobs/redirect/:signed_id/*filename
act show(c, signed_id)
    b | find_blob(signed_id)
    if b == nil => return http::head(404)
    url | storage::disk_url(c{"req"}, b, http::param(c{"req"}, "disposition"))
    return expires(http::redirect(c{"req"}, url))
xx

/// GET /rails/active_storage/representations/redirect/:signed_id/:variation_key/*filename
act representation(c, signed_id, variation_key)
    b | find_blob(signed_id)
    if b == nil => return http::head(404)
    v | storage::decode_variation(variation_key)
    if v == nil => return http::head(404)
    rep | storage::representation(b, v)
    if rep == nil => return http::head(404)
    url | storage::disk_url(c{"req"}, rep, http::param(c{"req"}, "disposition"))
    return expires(http::redirect(c{"req"}, url))
xx

/// GET /rails/active_storage/disk/:encoded_key/*filename
act disk(c, encoded_key)
    data | db::value("select campfire_as_verified($1, 'blob_key') as v", [encoded_key])
    if data == nil => return http::head(404)
    key | :json_parse(data)
    if :is_map(key) == false or :has(key, "key") == false => return http::head(404)
    path | storage::file_path(key{"key"})
    if :file_exists(path) == false => return http::head(404)
    return http::send_file_as("/_send/" + path, key{"content_type"}, key{"disposition"}, "max-age=3600, public")
xx

/// ActiveStorage::Blobs::ProxyController#show and
/// ActiveStorage::Representations::ProxyController#show: the file itself,
/// streamed by nginx. A Range request gets nginx's 206 with the headers
/// send_blob_byte_range_data sets; otherwise http_cache_forever applies,
/// its weak ETag being the request's full path.
act stream(c, b)
    path | "/_stream/" + storage::file_path(b{"key"})
    disposition | storage::content_disposition(storage::serving_disposition(b, http::param(c{"req"}, "disposition")), b{"filename"})
    if http::header("range") != ""
        res | http::send_file_as(path, storage::serving_type(b), disposition, "no-cache")
        :update!(res{"headers"}{"Content-Transfer-Encoding"}, "binary")
        return res
    xx
    fullpath | http::header("x-request-uri")
    if fullpath == "" => fullpath |= c{"req"}{"path"}
    etag | "W/\"" + db::value("select left(encode(sha256(convert_to($1, 'UTF8')), 'hex'), 32) as v", [fullpath]) + "\""
    res | http::send_file_as(path, storage::serving_type(b), disposition, "max-age=3155695200, public, immutable")
    if fresh(etag)
        res |= http::response(304, "")
        :update!(res{"headers"}{"Cache-Control"}, "max-age=3155695200, public, immutable")
    xx
    /// nginx serves the file and sets these from the X-Campfire- copies
    :update!(res{"headers"}{"X-Campfire-ETag"}, etag)
    :update!(res{"headers"}{"X-Campfire-Last-Modified"}, "Sat, 01 Jan 2011 00:00:00 GMT")
    if res{"status"} == 304
        :update!(res{"headers"}{"ETag"}, etag)
        :update!(res{"headers"}{"Last-Modified"}, "Sat, 01 Jan 2011 00:00:00 GMT")
    xx
    return res
xx

/// request.fresh? for an ETag and the 2011 Last-Modified http_cache_forever uses
act fresh(etag)
    inm | http::header("if-none-match")
    ims | http::header("if-modified-since")
    if inm == "" and ims == "" => return false
    etag_ok | true
    if inm != ""
        etag_ok |= false
        for t in :split(inm, ",")
            tag | :trim(:str(t))
            if tag == "*" or tag == etag or "W/" + tag == etag or tag == etag[2:] => etag_ok |= true
        xx
    xx
    time_ok | true
    if ims != ""
        time_ok |= db::value("select coalesce((select $1::timestamptz >= timestamptz '2011-01-01 00:00:00+00' where $1 ~ '^[A-Za-z]{3}, [0-9]{2} [A-Za-z]{3} [0-9]{4} [0-9:]{8} GMT$'), false) as v", [ims])
    xx
    return etag_ok and time_ok
xx

/// GET /rails/active_storage/blobs/proxy/:signed_id/*filename
act proxy(c, signed_id)
    b | find_blob(signed_id)
    if b == nil => return http::head(404)
    return stream(c, b)
xx

/// GET /rails/active_storage/representations/proxy/:signed_blob_id/:variation_key/*filename
act representation_proxy(c, signed_id, variation_key)
    b | find_blob(signed_id)
    if b == nil => return http::head(404)
    v | storage::decode_variation(variation_key)
    if v == nil => return http::head(404)
    rep | storage::representation(b, v)
    if rep == nil => return http::head(404)
    return stream(c, rep)
xx

/// POST /rails/active_storage/direct_uploads -- DirectUploadsController#create
act direct_upload(c)
    if session_user(c) == false => return http::head(401)
    req | c{"req"}
    p | req{"params"}
    spec | {}
    if :has(p, "blob") and :is_map(p{"blob"})
        spec |= p{"blob"}
    else
        for k in ["filename", "byte_size", "checksum", "content_type"]
            if :has(p, "blob[" + k + "]") => :update!(spec{k}, p{"blob[" + k + "]"})
        xx
    xx
    /// params.expect(blob: [...]): ActionController::ParameterMissing
    if :len(:keys(spec)) == 0
        res | http::response(400, "")
        :update!(res{"headers"}{"Content-Type"}, "text/html; charset=UTF-8")
        return res
    xx
    metadata | "\{}"
    if :has(spec, "metadata") and :is_map(spec{"metadata"}) => metadata |= :json_stringify(spec{"metadata"})
    size | nil
    if :has(spec, "byte_size") and spec{"byte_size"} != nil => size |= :int(:str(spec{"byte_size"}))
    b | storage::create_before_direct_upload(field(spec, "filename"), size, field(spec, "checksum"), field(spec, "content_type"), metadata)
    res | http::response(200, db::value("select campfire_direct_upload_json($1, $2)::text as v", [b{"id"}, req{"base"}]))
    :update!(res{"headers"}{"Content-Type"}, "application/json; charset=utf-8")
    return res
xx

/// ActiveStorageAuthentication: Campfire requires a signed-in session for
/// the direct-upload endpoints, which Active Storage itself leaves open.
act session_user(c)
    return c{"user"} != nil and c{"authenticated_by"} == "session"
xx

act field(m, k)
    if :has(m, k) == false or m{k} == nil => return nil
    return :str(m{k})
xx

/// PUT /rails/active_storage/disk/:encoded_token -- DiskController#update:
/// the bytes of a direct upload, which must match the token's content
/// type, length and checksum.
act disk_update(c, encoded_token)
    if session_user(c) == false => return http::head(401)
    raw | db::value("select campfire_as_verified($1, 'blob_token') as v", [encoded_token])
    if raw == nil => return http::head(404)
    token | :json_parse(raw)
    declared | webhooks::response_content_type(c{"req"}{"content_type"})
    if declared != nil => declared |= webhooks::mime_lookup(declared)[1]
    length | http::header("content-length")
    if declared != token{"content_type"} or length != :str(token{"content_length"}) => return http::head(422)
    body_file | c{"req"}{"body_file"}
    if body_file == "" or :file_exists(body_file) == false => return http::head(422)
    dest | storage::file_path(token{"key"})
    out | storage::tmp_out()
    if multipart::storage_cmd(["ingest", body_file, dest, out]) == false => return http::head(422)
    f | storage::read_fields(out)
    /// ActiveStorage::IntegrityError
    if :len(f) < 2 or f[1] != token{"checksum"}
        :delete_path!(dest)
        return http::head(422)
    xx
    return http::head(204)
xx
