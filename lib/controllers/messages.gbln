/// lib/controllers/messages.gbln -- MessagesController

import lib/http as http
import lib/auth as auth
import lib/db as db
import lib/storage as storage
import lib/ojson as ojson
import lib/html as html
import lib/views/messages as message_views
import lib/views/layout as layout
import lib/content as content
import lib/cable as cable
import lib/views/message_edit as edit_views
import lib/webhooks as webhooks

/// A page of messages for the scrollback paginator. $3/$4 are the message
/// to page before/after (0 when absent).
PAGE_SQL | """
select json_build_object(
  'room_id', mb.room_id,
  'messages', (
    select coalesce(json_agg(campfire_message_json(x) order by x.created_at, x.id), '[]') from (
      select * from (select * from messages where room_id = mb.room_id and $3 = 0 and $4 = 0 order by created_at desc, id desc limit 40) last_page
      union all
      select * from (select m.* from messages m, messages a where a.id = $3 and a.room_id = mb.room_id and m.room_id = mb.room_id
                     and m.created_at < a.created_at order by m.created_at desc, m.id desc limit 40) before_page
      union all
      select * from (select m.* from messages m, messages a where a.id = $4 and a.room_id = mb.room_id and m.room_id = mb.room_id
                     and m.created_at > a.created_at order by m.created_at, m.id limit 40) after_page
    ) x),
  'missing', ($3 <> 0 and not exists (select 1 from messages where id = $3 and room_id = mb.room_id))
          or ($4 <> 0 and not exists (select 1 from messages where id = $4 and room_id = mb.room_id)))
from memberships mb where mb.user_id = $1 and mb.room_id = $2
"""

/// The bot API's page: PAGE_SQL's messages for a room already found, with
/// the count and whether more lie beyond the page. $1 room, $2 before, $3 after.
PAGE_SQL_FOR_API | """
select json_build_object('messages', coalesce(json_agg(campfire_message_json(x) order by x.created_at, x.id), '[]'),
  'total', (select count(*) from messages where room_id = $1),
  'missing', ($2 <> 0 and not exists (select 1 from messages where id = $2 and room_id = $1))
          or ($3 <> 0 and not exists (select 1 from messages where id = $3 and room_id = $1)),
  'more_before', exists (select 1 from messages o where o.room_id = $1 and o.created_at < min(x.created_at)),
  'more_after', exists (select 1 from messages o where o.room_id = $1 and o.created_at > max(x.created_at)))
from (
  select * from (select * from messages where room_id = $1 and $2 = 0 and $3 = 0 order by created_at desc, id desc limit 40) last_page
  union all
  select * from (select m.* from messages m, messages a where a.id = $2 and a.room_id = $1 and m.room_id = $1
                 and m.created_at < a.created_at order by m.created_at desc, m.id desc limit 40) before_page
  union all
  select * from (select m.* from messages m, messages a where a.id = $3 and a.room_id = $1 and m.room_id = $1
                 and m.created_at > a.created_at order by m.created_at, m.id limit 40) after_page
) x
"""

act api_page(room_id, before, after)
    return db::doc(PAGE_SQL_FOR_API, [room_id, before, after])
xx

act numeric(s)
    return :is_matching(s, "^[0-9]+$")
xx

act int_param(req, name)
    v | http::param(req, name)
    if v == "" => return 0
    if numeric(v) == false => return -1
    return :int(v)
xx

/// GET /rooms/:room_id/messages?before=|after=
act index(c, room_id)
    req | c["req"]
    if numeric(room_id) == false => return http::error_page(404)
    before | int_param(req, "before")
    after | int_param(req, "after")
    if before < 0 or after < 0 => return http::error_page(404)
    data | db::doc(PAGE_SQL, [c["user"]["id"], :int(room_id), before, after])
    if data == nil or data["missing"] => return http::error_page(404)
    list | data["messages"]
    if :len(list) == 0 => return http::head(204)
    return http::html("\n" + message_views::collection(c, list))
xx

/// The context broadcasts render in: no current user and no session, as
/// with Rails' ApplicationController.renderer.
act broadcast_context(c)
    return {"req": c["req"], "csrf": nil, "user": nil, "account": c["account"]}
xx

/// Views rendered for a Turbo Stream response omit form tokens.
act stream_context(c)
    :update!(c["csrf"], nil)
    return c
xx

act room_not_found(c)
    p | layout::page("Campfire")
    :update!(p["main"], """<turbo-frame id="composer-frame">
  <span class="composer__input input input--actor shake margin-block-end txt-negative txt-align-center" style="--input-border-color: var(--color-negative)">
      <span>This room was deleted.</span>
  </span>
</turbo-frame>
""")
    return http::html(layout::render(c, p))
xx

/// POST /rooms/:room_id/messages
act create(c, room_id)
    req | c["req"]
    if numeric(room_id) == false => return room_not_found(c)
    room | db::one("select r.id, r.type from memberships mb join rooms r on r.id = mb.room_id where mb.user_id = $1 and r.id = $2", [c["user"]["id"], :int(room_id)])
    if room == nil => return room_not_found(c)
    body | nil
    if http::has_param(req, "message[body]") => body |= http::param(req, "message[body]")
    upload | nil
    if :has(req["files"], "message[attachment]") => upload |= req["files"]["message[attachment]"]
    m | post_with(c, room, body, http::param(req, "message[client_message_id]"), upload)
    webhooks::deliver_later(m)
    return http::turbo_stream(cable::stream_tag("append", "messages_" + html::room_key(room), message_views::single(stream_context(c), m)) + "\n")
xx

/// Message creation with Message#broadcast_create: append to the room's
/// message stream, then tell each member's unread-rooms stream. Returns
/// the message.
act post(c, room, raw_body, client_id)
    return post_with(c, room, raw_body, client_id, nil)
xx

/// Message.create_with_attachment!: the message, with an uploaded file
/// attached and its thumbnail (or video poster) processed.
act post_with(c, room, raw_body, client_id, upload)
    body | nil
    plain | ""
    if raw_body != nil
        body |= content::canonicalize(raw_body)
        plain |= content::plain_text(with_mentions(body))
    xx
    created | db::doc("select campfire_create_message($1, $2, $3, $4, $5)", [c["user"]["id"], room["id"], body, client_id, plain])
    m | created["message"]
    if upload != nil
        b | storage::create_blob(upload)
        if b != nil
            db::exec("select campfire_attach('Message', $1, 'attachment', $2)", [m["id"], b["id"]])
            storage::process_attachment(b)
            m |= db::doc("select campfire_message_json(m) from messages m where m.id = $1", [m["id"]])
        xx
    xx
    stream | db::value("select campfire_gid_param($1, $2) || ':messages'", [room["type"], room["id"]])
    cable::broadcast(stream, cable::stream_tag("append", "messages_" + html::room_key(room), message_views::single(broadcast_context(c), m)))
    streams | []
    for id in created["member_ids"]
        :put_last!(streams, "user_" + :str(id) + "_unreads")
    xx
    cable::broadcast_many(streams, {"roomId": room["id"]})
    return m
xx

/// A body with its mentioned users, for plain text ("@Name").
act with_mentions(body)
    if :has(body, "action-text-attachment") == false => return {"body": body}
    return {"body": body, "mentions": db::doc("select campfire_mentions($1)", [body])}
xx

/// set_room (RoomScoped) and set_message: the message, in that room, in one
/// of the user's rooms.
act find_message(c, room_id, id, for_edit)
    if numeric(room_id) == false or numeric(id) == false => return nil
    return db::doc("select campfire_reachable_message($1, $2, $3, $4)", [c["user"]["id"], :int(id), :int(room_id), for_edit])
xx

act can_administer(c, m)
    return auth::can_administer(c, m["creator_id"])
xx

/// GET /rooms/:room_id/messages/:id -- `render @message` in the full layout
act show(c, room_id, id)
    found | find_message(c, room_id, id, false)
    if found == nil => return http::error_page(404)
    p | layout::page("Campfire")
    :update!(p["main"], message_views::single(c, found["message"]) + "\n")
    :update!(p["frame_layout"], false)
    return http::html(layout::render(c, p))
xx

/// GET /rooms/:room_id/messages/:id/edit
act edit(c, room_id, id)
    found | find_message(c, room_id, id, true)
    if found == nil => return http::error_page(404)
    m | found["message"]
    if can_administer(c, m) == false => return http::head(403)
    p | layout::page("Campfire")
    :update!(p["main"], edit_views::edit(c, m, found["users"]))
    :update!(p["frame_layout"], false)
    return http::html(layout::render(c, p))
xx

/// PATCH /rooms/:room_id/messages/:id
act update(c, room_id, id)
    req | c["req"]
    found | find_message(c, room_id, id, false)
    if found == nil => return http::error_page(404)
    m | found["message"]
    if can_administer(c, m) == false => return http::head(403)
    body | content::canonicalize(http::param(req, "message[body]"))
    m |= db::doc("select campfire_update_message($1, $2, $3)", [m["id"], body, content::plain_text(with_mentions(body))])
    room | {"id": m["room_id"], "type": found["room_type"]}
    stream | db::value("select campfire_gid_param($1, $2) || ':messages'", [room["type"], room["id"]])
    cable::broadcast(stream, cable::stream_tag_with("maintain_scroll=\"true\"", "replace", message_views::dom(m, "presentation"), message_views::presentation(broadcast_context(c), m)))
    if :has(req["accept"], "application/json")
        res | http::response(200, ojson::encode(message_views::to_json(c, m)))
        :update!(res["headers"]["Content-Type"], "application/json; charset=utf-8")
        return res
    xx
    return http::redirect(req, "/rooms/" + :str(m["room_id"]) + "/messages/" + :str(m["id"]))
xx

/// DELETE /rooms/:room_id/messages/:id
act destroy(c, room_id, id)
    found | find_message(c, room_id, id, false)
    if found == nil => return http::error_page(404)
    m | found["message"]
    if can_administer(c, m) == false => return http::head(403)
    db::exec("select campfire_destroy_message($1)", [m["id"]])
    stream | db::value("select campfire_gid_param($1, $2) || ':messages'", [found["room_type"], m["room_id"]])
    tag | cable::stream_tag("remove", message_views::dom(m, ""), nil)
    cable::broadcast(stream, tag)
    return http::turbo_stream(tag + "\n")
xx
