/// lib/controllers/cable.gbln -- ActionCable's server side over long polling.
///
/// goblin-host answers each request once and has no WebSocket support, so
/// cable/goblin_cable.js stands in for the browser's
/// WebSocket on /cable and speaks to this endpoint with JSON POSTs:
///
///   connect      ApplicationCable::Connection#connect
///   subscribe    a channel's `subscribed` (and PresenceChannel's on_subscribe)
///   unsubscribe  PresenceChannel's on_unsubscribe
///   message      a channel action (presence present/refresh, typing start/stop)
///   poll         waits for broadcasts on the subscribed streams
///
/// Authorization is re-checked on every poll, so a revoked membership stops
/// delivery (Campfire disconnects the socket and rejects the resubscribe).

import lib/http as http
import lib/db as db
import lib/cable as cable

POLL_WAIT | 20s

act stream_for(user_id, identifier)
    return db::value("select campfire_cable_stream($1, $2) as v", [user_id, identifier])
xx

act identifier_json(identifier)
    if :starts_with(:trim(identifier), "\{") == false => return {}
    return :json_parse(identifier)
xx

act room_of(ident)
    rid | ident{"room_id"}
    if rid == nil => return 0
    s | :str(rid)
    if :is_matching(s, "^[0-9]+$") == false => return 0
    return :int(s)
xx

/// PresenceChannel's present: the membership is marked connected and read,
/// and the user's other tabs hear that the room was read.
act present(uid, room_id)
    if db::value("select campfire_presence($1, $2, 'present') as v", [uid, room_id]) == true
        cable::broadcast("user_" + :str(uid) + "_reads", {"room_id": room_id})
    xx
    return nil
xx

act handle(c)
    req | c{"req"}
    /// ActionCable's allowed_request_origins: same origin only.
    origin | http::header("origin")
    if origin != "" and origin != req{"base"} => return http::json(403, {"error": "origin"})
    if c{"user"} == nil or c{"authenticated_by"} != "session"
        return http::json(401, {"type": "disconnect", "reason": "unauthorized", "reconnect": false})
    xx
    uid | c{"user"}{"id"}
    p | req{"params"}
    command | http::param(req, "command")
    if command == "connect"
        return http::json(200, {"cursor": cable::cursor()})
    xx
    if command == "poll" => return poll(uid, p{"subscriptions"})
    identifier | http::param(req, "identifier")
    stream | stream_for(uid, identifier)
    ident | identifier_json(identifier)
    channel | ident{"channel"}
    if command == "subscribe"
        if stream == nil => return http::json(200, {"type": "reject_subscription"})
        if channel == "PresenceChannel" => present(uid, room_of(ident))
        since | cable::cursor()
        return http::json(200, {"type": "confirm_subscription", "since": since})
    xx
    if stream == nil => return http::json(200, {"type": "reject_subscription"})
    if command == "unsubscribe"
        if channel == "PresenceChannel" => db::exec("select campfire_presence($1, $2, 'absent')", [uid, room_of(ident)])
        return http::json(200, {})
    xx
    if command == "message"
        data | {}
        raw | http::param(req, "data")
        if :starts_with(:trim(raw), "\{") => data |= :json_parse(raw)
        act_name | data{"action"}
        if channel == "PresenceChannel" and act_name == "present"
            present(uid, room_of(ident))
        elif channel == "PresenceChannel" and (act_name == "absent" or act_name == "refresh")
            db::exec("select campfire_presence($1, $2, $3)", [uid, room_of(ident), act_name])
        elif channel == "TypingNotificationsChannel" and (act_name == "start" or act_name == "stop")
            cable::broadcast(stream, {"action": act_name, "user": {"id": uid, "name": c{"user"}{"name"}}})
        xx
        return http::json(200, {})
    xx
    return http::json(400, {"error": "unknown command"})
xx

/// A cursor from the browser: a whole number, or 0.
act since_of(v)
    if v == nil => return 0
    s | :str(v)
    if :is_matching(s, "^[0-9]+$") == false => return 0
    return :int(s)
xx

/// subscriptions: [{"identifier": ..., "since": broadcast id}, ...]
act poll(uid, given)
    subs | given
    if subs == nil => subs |= []
    identifiers | []
    for sub in subs
        :put_last!(identifiers, sub{"identifier"})
    xx
    resolved | []
    if :len(identifiers) > 0
        resolved |= db::doc("select coalesce(json_agg(json_build_object('s', campfire_cable_stream($1, x)) order by n), '[]') from json_array_elements_text($2::json) with ordinality t(x, n)", [uid, :json_stringify(identifiers)])
    xx
    streams | []
    idents | []
    rejected | []
    i | 0
    for sub in subs
        stream | resolved[i]{"s"}
        if stream == nil
            :put_last!(rejected, sub{"identifier"})
        elif stream != ""
            :put_last!(streams, {"stream": stream, "since": sub{"since"}})
            :put_last!(idents, sub{"identifier"})
        xx
        i |= i + 1
    xx
    messages | []
    if :len(rejected) == 0 and :len(streams) > 0
        subs_for_hub | []
        n | 0
        for s in streams
            :put_last!(subs_for_hub, {"i": n, "stream": s{"stream"}, "since": since_of(s{"since"})})
            n |= n + 1
        xx
        found | cable::wait(subs_for_hub, POLL_WAIT)
        for f in found
            :put_last!(messages, {"identifier": idents[f{"i"}], "id": f{"id"}, "message": f{"payload"}})
        xx
    xx
    return http::json(200, {"messages": messages, "rejected": rejected})
xx
