/// lib/controllers/rooms.gbln -- RoomsController and WelcomeController

import lib/http as http
import lib/auth as auth
import lib/db as db
import lib/html as html
import lib/views/layout as layout
import lib/views/rooms as room_views
import lib/views/messages as message_views


/// The room page document. $3 is the message to show the page around, or 0.
ROOM_SQL | """
select json_build_object(
  'room', campfire_room_json(r),
  'involvement', mb.involvement,
  'original', r.id = (select id from rooms order by created_at, id limit 1),
  'paged', (select count(*) from messages where room_id = r.id) > 40,
  'stream', campfire_signed_stream(campfire_gid_param(r.type, r.id) || ':messages'),
  'messages', (
    select coalesce(json_agg(campfire_message_json(x) order by x.created_at, x.id), '[]') from (
      select * from (select * from messages where room_id = r.id and $3 = 0 order by created_at desc, id desc limit 40) last_page
      union all
      select * from (select m.* from messages m, messages a where a.id = $3 and a.room_id = r.id and m.room_id = r.id
                     and m.created_at < a.created_at order by m.created_at desc, m.id desc limit 40) before_page
      union all
      select * from messages where id = $3 and room_id = r.id
      union all
      select * from (select m.* from messages m, messages a where a.id = $3 and a.room_id = r.id and m.room_id = r.id
                     and m.created_at > a.created_at order by m.created_at, m.id limit 40) after_page
    ) x))
from memberships mb join rooms r on r.id = mb.room_id
where mb.user_id = $1 and mb.room_id = $2
"""

act numeric(s)
    return :is_matching(s, "^[0-9]+$")
xx

act not_found_redirect(c)
    c |= auth::flash_next(c, "alert", "Room not found or inaccessible")
    return auth::keep(c, http::redirect(c["req"], "/"))
xx

/// GET /rooms/:id and /rooms/:id/@:message_id
act show(c, id, message_id)
    if numeric(id) == false => return not_found_redirect(c)
    at | 0
    if message_id != "" and numeric(message_id) => at |= :int(message_id)
    data | db::doc(ROOM_SQL, [c["user"]["id"], :int(id), at])
    if data == nil => return not_found_redirect(c)
    if at != 0 and :len(data["messages"]) == 0
        data |= db::doc(ROOM_SQL, [c["user"]["id"], :int(id), 0])
    xx
    room | data["room"]
    name | message_views::room_name(room, c["user"]["id"])
    p | layout::page(name)
    :update!(p["body_class"], "sidebar")
    rid | room["id"]
    :update!(p["head"], "<meta name=\"turbo-cache-control\" content=\"no-preview\">  \n  <meta name=\"current-room-id\" content=\"{rid}\">\n")
    :update!(p["nav"], room_views::nav(c, room, name))
    :update!(p["sidebar"], room_views::sidebar_frame())
    :update!(p["main"], room_views::show_main(c, data))
    :update!(p["footer"], room_views::composer(c, room))
    res | http::html(layout::render(c, p))
    res |= http::add_cookie(res, "last_room", :str(rid), PERMANENT + "; samesite=lax")
    return res
xx

/// GET /rooms -- the most recently joined room
act index(c)
    room | db::one("select r.id from memberships mb join rooms r on r.id = mb.room_id where mb.user_id = $1 order by mb.id desc", [c["user"]["id"]])
    if room == nil => return http::redirect(c["req"], "/")
    return http::redirect(c["req"], "/rooms/" + :str(room["id"]))
xx

/// GET / -- WelcomeController#show: the last room visited, else the first
/// room, else the empty state.
act root(c)
    last | http::cookie_of(c["req"], "last_room")
    if last == "" or numeric(last) == false => last |= "0"
    room | db::one("select r.id from memberships mb join rooms r on r.id = mb.room_id where mb.user_id = $1 order by (r.id = $2) desc, r.created_at, r.id", [c["user"]["id"], :int(last)])
    if room != nil => return http::redirect(c["req"], "/rooms/" + :str(room["id"]))
    p | layout::page("No rooms yet")
    :update!(p["body_class"], "sidebar")
    :update!(p["sidebar"], room_views::sidebar_frame())
    :update!(p["main"], welcome_main())
    return http::html(layout::render(c, p))
xx

act welcome_main()
    icon | html::img("messages-empty.svg", "aria-hidden=\"true\" class=\"colorize--black translucent\" ", 0)
    return """


<div id="message-area" class="message-area">
  <div class="message-area--empty min-width center">
    <figure class="center pad">
      {icon}
    </figure>
  </div>
</div>
"""
xx

/// DELETE /rooms/:id
act destroy(c, id)
    if numeric(id) == false => return not_found_redirect(c)
    room | db::one("select r.id, r.creator_id, r.type from memberships mb join rooms r on r.id = mb.room_id where mb.user_id = $1 and r.id = $2", [c["user"]["id"], :int(id)])
    if room == nil => return not_found_redirect(c)
    if auth::can_administer(c, room["creator_id"]) == false => return http::head(403)
    db::exec("select campfire_destroy_room($1)", [room["id"]])
    return http::redirect(c["req"], "/")
xx
