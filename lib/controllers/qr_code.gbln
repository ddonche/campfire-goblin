/// lib/controllers/qr_code.gbln -- QrCodeController#show.
///
/// The code itself is lib/qrcode.gbln, a QR encoder written in Goblin whose
/// output matches RQRCode's module for module. Encoding a long URL takes
/// seconds under the interpreter the web host runs scripts with, so the SVG
/// is rendered by a separate Goblin process and kept in storage/qr, keyed
/// by the request's id: Rails caches these for a year in the browser, and
/// the same link is opened again and again.

import lib/http as http
import lib/multipart as multipart

CACHE | "storage/qr"

act cache_path(id)
    return CACHE + "/" + id + ".svg"
xx

/// GET /qr_code/:id -- the id is Base64.urlsafe_encode64 of the URL
act show(c, id)
    if :is_matching(id, "^[A-Za-z0-9_=-]+$") == false => return http::head(404)
    path | cache_path(id)
    if :file_exists(path) == false
        url | decode_id(id)
        if url == nil => return http::head(404)
        if render(url, path) == false => return http::head(404)
    xx
    res | http::response(200, :read_text(path))
    :update!(res{"headers"}{"Content-Type"}, "image/svg+xml; charset=utf-8")
    :update!(res{"headers"}{"Cache-Control"}, "max-age=31556952, public")
    return res
xx

/// Base64.urlsafe_decode64(params[:id]): bin/storage decodes it, since
/// Goblin has no base64 builtin and no way to build a character from a
/// code point.
act decode_id(id)
    out | "/tmp/campfire-qr-" + :str(:secure_random(100000, 999999))
    if multipart::storage_cmd(["unb64", id, out]) == false => return nil
    if :file_exists(out) == false => return nil
    text | :read_text(out)
    :delete_path!(out)
    if :trim(text) == "" => return nil
    return text
xx

/// Renders the code in its own process, where it runs as the module's own
/// top-level program (lib/qrcode.gbln imports nothing, so it stays quick to
/// load) and writes the SVG to `path`.
act render(url, path)
    root | multipart::root()
    r | :json_parse(:run_cmd("mkdir -p " + multipart::shq(root + "/" + CACHE) + " && QR_URL=" + multipart::shq(url) + " QR_OUT=" + multipart::shq(root + "/" + path) + " goblin run " + multipart::shq(root + "/lib/qrcode.gbln"), root))
    if r{"ok"} == false => return false
    if :file_exists(path) == false => return false
    if :len(:read_text(path)) == 0
        :delete_path!(path)
        return false
    xx
    return true
xx
