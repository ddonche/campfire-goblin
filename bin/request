#!/bin/bash
# Runs one request through the app without a server, for debugging:
#   bin/request GET /rooms/1 [cookie-header] [body]
cd "$(dirname "$0")/.."
export GOBLIN_NONINTERACTIVE=1 GOBLIN_METHOD="$1" GOBLIN_PATH=/api/app
export DATABASE_URL="${DATABASE_URL:-postgres://postgres@127.0.0.1:5433/campfire}"
uri="$2"
export GOBLIN_HEADERS_JSON=$(python3 -c 'import json,sys; print(json.dumps({"x-request-uri": sys.argv[1], "host": "127.0.0.1:3001", "cookie": sys.argv[2], "user-agent": "Ruby", "content-type": "application/x-www-form-urlencoded"}))' "$uri" "$3")
if [ -n "$4" ]; then f=$(mktemp); printf '%s' "$4" > "$f"; export GOBLIN_REQUEST_FILE="$f"; fi
exec ${GOBLIN:-goblin} app/api/app.gbln
