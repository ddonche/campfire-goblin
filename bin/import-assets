#!/usr/bin/env ruby
# Imports Campfire's compiled front-end assets into this port.
#
#   bin/import-assets CAMPFIRE_DIR PAGE_HTML
#
# CAMPFIRE_DIR is a once-campfire checkout after `bin/rails assets:precompile`
# (Campfire's own JS/CSS/images plus the Turbo, Stimulus, Lexxy and ActionCable
# builds from its gems). PAGE_HTML is any page Campfire rendered; the
# stylesheet, importmap and modulepreload tags are lifted from its <head>.
#
# Goblin has no hashing builtins, so asset digests (and this importer) stay
# outside Goblin, the way Rails' asset pipeline is outside the app proper.
require "fileutils"
require "json"
require "digest"

root = File.expand_path("..", __dir__)
campfire, page = ARGV
abort "usage: bin/import-assets CAMPFIRE_DIR PAGE_HTML" unless campfire && page

src = File.join(campfire, "public/assets")
dst = File.join(root, "public/assets")
FileUtils.rm_rf(dst)
FileUtils.cp_r(src, dst)
manifest = JSON.parse(File.read(File.join(src, ".manifest.json")))

# The polling stand-in for WebSocket (see public/cable/README in GAPS.md).
shim_src = File.join(root, "cable/goblin_cable.js")
shim = File.read(shim_src)
shim_name = "goblin_cable-#{Digest::SHA256.hexdigest(shim)[0, 8]}.js"
File.write(File.join(dst, shim_name), shim)
manifest["goblin_cable.js"] = { "digested_path" => shim_name }

html = File.read(page)
start = html.index('<link rel="stylesheet"') or abort "no stylesheet tags in #{page}"
finish = html.index('<script type="module">import "application"</script>') or abort "no importmap in #{page}"
head = html[start...finish] + %(<script type="module">import "application"</script>)
File.write(File.join(root, "lib/head_assets.html"),
  %(<script src="/assets/#{shim_name}"></script>\n    ) + head)

lines = manifest.sort.map { |logical, entry| %(    "#{logical}": "/assets/#{entry.fetch('digested_path')}") }
File.write(File.join(root, "lib/assets.gbln"), <<~GBLN)
  /// lib/assets.gbln -- generated by bin/import-assets; do not edit.
  /// Maps Campfire's logical asset names to their digested public paths.

  ASSETS | {
  #{lines.join(",\n")}
  }

  act path(name)
      if :has(ASSETS, name) => return ASSETS[name]
      return "/" + name
  xx
GBLN
puts "imported #{manifest.size} assets; cable shim #{shim_name}"
